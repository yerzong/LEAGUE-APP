# Copy to .env.local (never commit it). Validated with Zod: src/config/env.ts, src/config/public-env.ts
# Base URL of apps/api, used server-side only.
API_URL=http://localhost:4000

# Public URL of this app; auth emails and OAuth redirect back to /auth/callback here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project (penta-dev for development). Dashboard > Project Settings > API Keys.
# Only the publishable key belongs here; never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://tcxqywnpytfrytpsqiln.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shows "Continuar con Google" once the provider is enabled in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# OAuth credentials are configured in Supabase, not read by this app. They are
# listed here so `supabase config push` / `supabase start` can substitute them
# into supabase/config.toml. Discord: https://discord.com/developers/applications
# (redirect URL: https://tcxqywnpytfrytpsqiln.supabase.co/auth/v1/callback).
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# /admin/kitchen-sink: on in development, off in production unless set to true.
# KITCHEN_SINK_ENABLED=false
