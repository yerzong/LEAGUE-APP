{
  "name": "league-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "pnpm --filter @league/db gen:types",
    "seed:demo": "pnpm --filter @league/api seed:demo",
    "seed:reset": "pnpm --filter @league/api seed:reset"
  },
  "prettier": "@league/config/prettier",
  "devDependencies": {
    "@league/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
