{
  "name": "@league/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env src/dev/seed/cli.ts demo",
    "seed:reset": "tsx --env-file-if-exists=.env src/dev/seed/cli.ts reset"
  },
  "dependencies": {
    "@league/contracts": "workspace:*",
    "@league/core": "workspace:*",
    "@league/db": "workspace:*",
    "@league/i18n": "workspace:*",
    "@league/integrations": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@supabase/supabase-js": "2.118.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@league/config": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
