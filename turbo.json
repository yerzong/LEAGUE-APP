{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": [
        "API_URL",
        "PORT",
        "WEB_ORIGIN",
        "APP_VERSION",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_*"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "@league/web#test:e2e": {
      "dependsOn": ["build", "@league/api#build"],
      "passThroughEnv": [
        "API_URL",
        "PORT",
        "WEB_ORIGIN",
        "APP_VERSION",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_*"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_URL",
        "PORT",
        "WEB_ORIGIN",
        "APP_VERSION",
        "NODE_ENV",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_*"
      ]
    }
  }
}
