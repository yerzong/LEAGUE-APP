# Copy to .env (never commit it). Validated with Zod on startup: src/config/env.ts
NODE_ENV=development
PORT=4000
# Origin allowed by CORS (the web app).
WEB_ORIGIN=http://localhost:3000
# Reported by GET /health.
APP_VERSION=0.0.0
# Supabase project that issues the access tokens (penta-dev for development).
# Dashboard > Project Settings > API Keys. Never use the secret/service_role key here.
SUPABASE_URL=https://tcxqywnpytfrytpsqiln.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) for business writes. Server side only: never in the web
# app, never committed, never logged. Dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=
# Tenant used until requests carry their organization.
DEFAULT_ORGANIZATION_SLUG=penta-league
# Riot account verification: `stub` (default, never calls Riot) or `riot`.
# `riot` needs RIOT_API_KEY (developer or production key, server side only).
RIOT_PROVIDER=stub
RIOT_API_KEY=
# Seconds between check-in sweeps (open due windows, forfeit no-shows). 0 = off.
CHECKIN_SWEEP_SECONDS=60
# Dev tools (docs/specs/m0dev): `pnpm seed:demo` / `pnpm seed:reset` only run with
# SEED_ENABLED=true and only against penta-dev. SEED_DEMO_PASSWORD overrides the
# password of every demo account (fictional, @demo.penta.local).
# SEED_ENABLED=true
# SEED_DEMO_PASSWORD=
